<clickhouse>
    <storage_configuration>
        <disks>
            <default>
            </default>
            <s3_cold_storage>
                <type>s3</type>
                <endpoint>https://s3.amazonaws.com/o-teu-bucket-de-arquivo/clickhouse-cold/</endpoint>
                <access_key_id>o_teu_access_key</access_key_id>
                <secret_access_key>o_teu_secret_key</secret_access_key>
                <send_metadata>true</send_metadata>
            </s3_cold_storage>
        </disks>

        <policies>
            <tiered_storage_policy>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <disk>s3_cold_storage</disk>
                        <max_data_part_size>10737418240</max_data_part_size>
                    </cold>
                </volumes>
                <move_factor>0.1</move_factor>
            </tiered_storage_policy>
        </policies>
    </storage_configuration>
</clickhouse>