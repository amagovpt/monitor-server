  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf dist",
    "typeorm": "typeorm-ts-node-commonjs",
    "build": "cross-env NODE_ENV=production nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": " nest start",
    "start:dev": "nest start --watch",
    "start:debug": "cross-env NODE_ENV=development NEST_DEBUG=true nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "start:local": "cross-env NODE_ENV=development node dist/main",
    "lint": "eslint '{src,apps,libs,test}/**/*.ts' --fix",
    "test": "jest -c jest.config.js --detectOpenHandles --no-cache",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test/govUser": "jest gov-user/gov-user.service.spec.ts",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:aStatement": "jest accessibility-statement/page-parser-test.spec.ts",
    "graph": "madge --image graph.png --extensions ts --ts-config tsconfig.json src/main.ts",
    "graph:check": "madge --circular --extensions ts --ts-config tsconfig.json src/main.ts",
    "graph:debug": "npm run graph:check -- --debug",
    "graph:summary": "madge --summary --extensions ts --ts-config tsconfig.json src/main.ts",
    "migration:generate": "npm run typeorm:base -- migration:generate -d src/data-source.ts migrations/",
    "migration:run": "npm run typeorm:base -- migration:run -d src/data-source.ts",
    "typeorm:base": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:revert": "npm run typeorm:base -- migration:revert -d src/data-source.ts",
    "schema:drop": "npm run typeorm:base -- schema:drop -d src/data-source.ts",
    "openfga:test": "fga model test --tests openfga/tests.fga.yaml",
    "check:unused": "npx knip",
    "security:scan": "semgrep scan --config .semgrep.yml",
    "security:scan:ci": "semgrep scan --pro --config .semgrep/ --config p/nestjs --config p/typescript --config p/secrets --json ",
    "prepare": "husky"
  },
